# Local environment template for aus-fuel-forecaster.
#
# Copy this file to .env (gitignored) and fill in real values. Never commit
# .env — it contains secrets. See docs/troubleshooting/python_environment.md
# for setup details.

# Open-Meteo API key — free registration at https://open-meteo.com/en/pricing.
# Used by fetch.weather for higher rate limits (10x the unauthenticated free
# tier) on both the Historical Forecast API and the ERA5 Archive API.
# Leave blank to use unauthenticated rate limits (600/min, 5000/hr, 10000/day).
OPENMETEO_API_KEY=
