# Data — gitignored except .gitkeep and data/static/
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained models
models/*
!models/.gitkeep
# Per-experiment model dirs (PR C orchestrator and similar). Same
# rationale as models/* — large LightGBM pickles, easy to regenerate
# from the committed features parquet + train config.
models_*/

# Results — keep the directory but not generated artefacts.
# (You may want to commit comparison.md once it stabilises; uncomment as needed.)
results/*
!results/.gitkeep
!results/shap/.gitkeep
# README.md is hand-written documentation, not a generated artefact — track it.
!results/README.md
# PR C experiment artefacts — tracked so the multi-experiment narrative
# (E1-E5 + E4a/b ablation) is reproducible from git, not only from a
# local re-run. Includes the summary, raw metrics, per-experiment
# comparison.md tables, and the preserved Round-1 backups.
!results/pr_c_*.md
!results/pr_c_*.json
# v3.0 smoke + Phase 2 re-eval reports — same rationale.
!results/v3_*.md
!results/v3_*.json
# v4 fold-instability experiment reports — same rationale.
!results/v4_*.md
!results/v4_*.json
# v5 7-day horizon experiment reports — same rationale.
!results/v5_*.md
!results/v5_*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
dist/
*.egg-info/
*.egg
.eggs/
.installed.cfg

# uv / venv
.venv/
venv/
env/
.uv/
uv.lock

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE / AI tooling
.idea/
.vscode/
# Claude Code scratch space — embedded git worktrees + agent state.
# Tools (ruff, mypy) also extend-exclude this in pyproject.toml.
.claude/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/

# Research spike outputs — captured stdout from one-off scripts under
# tools/research/. Scripts themselves are tracked; output is ephemeral
# and re-generatable, and may contain user-specific paths/emails.
tools/research/*.out.txt
tools/research/*.log
tools/research/*.log.*
tools/research/*.tee.log

# Local environment / secrets — API keys, OAuth tokens, etc.
# .env contains real secrets and must never be committed.
# .env.example is the template (committed, no real values).
.env
!.env.example
